# RMS Ads Environment Variables

# Resend API Key for sending Contact Form enquiries to the RMS Ads team
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Notification recipient email address where leads will be delivered
CONTACT_NOTIFICATION_EMAIL=contact@rmsads.com

# Optional sender email address (must be a verified domain on Resend, or leave as default onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=RMS Ads Enquiries <onboarding@resend.dev>

# Website URL
NEXT_PUBLIC_SITE_URL=https://rmsads.com

